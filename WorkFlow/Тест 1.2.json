    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst trigger = $('When Executed by Another Workflow').item.json;\n\nif (!rows || !rows.length) {\n  return [{ json: { is_first: false, ...trigger } }];\n}\n\n// Достаем все числовые ID из базы\nconst ids = rows.map(r => Number(r.id)).filter(id => !isNaN(id));\nconst minId = Math.min(...ids);\n\n// ID текущей записи, передаваемый из основного воркфлоу (или ищем по db_row_id)\nconst currentDbId = Number(trigger.db_row_id || trigger.id);\n\n// Если передали db_row_id — сравниваем по нему, иначе резервный поиск по file_id\nlet is_first = false;\n\nif (!isNaN(currentDbId)) {\n  is_first = (currentDbId === minId);\n} else {\n  const triggerFileId = String(trigger.file_id || '').trim();\n  const currentRow = rows.find(r => String(r.file_id || '').trim() === triggerFileId);\n  const currentId = currentRow ? Number(currentRow.id) : null;\n  is_first = (currentId !== null && currentId === minId);\n}\n\nreturn [{\n  json: {\n    is_first,\n    chat_id: trigger.chat_id,\n    media_group_id: trigger.media_group_id,\n    file_id: trigger.file_id\n  }\n}];"
      },
